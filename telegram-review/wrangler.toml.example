name = "scm-telegram-review"
main = "worker.mjs"
compatibility_date = "2026-11-01"

# Copy to wrangler.toml locally, then insert your D1 database ID.
# Never store secrets or personal IDs in the repository.
[[d1_databases]]
binding = "DB"
database_name = "scm-review"
database_id = "REPLACE_LOCALLY"
